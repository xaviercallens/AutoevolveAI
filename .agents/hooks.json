{
  "antigravity-session-hardening": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python3 .agents/scripts/post_tool_guard.py",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 .agents/scripts/stop_attestation_check.py",
        "timeout": 15
      }
    ]
  }
}
