{
  "mcpServers": {
    "antigravity-guard": {
      "command": "python3",
      "args": ["mcp_guard_server.py"],
      "env": {
        "PYTHONPATH": "."
      }
    },
    "logic-planner": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "local-filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/home/xavkal/xdev/AutoevolveAI/anse",
        "/home/xavkal/xdev/AutoevolveAI/tests",
        "/home/xavkal/xdev/AutoevolveAI/formal"
      ]
    },
    "github-radar": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "memory-graph": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-memory"]
    }
  }
}
