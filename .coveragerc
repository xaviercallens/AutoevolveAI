[run]
branch = True
source =
    anse
    execution_attestation
    antigravity_guard
    pytest_prod_trace
    gateway
    claude_workflow
    harness_hook
    context_manager
    attestation_reporter
    main
    web
omit =
    tests/*
    vendor/*

[report]
show_missing = True
skip_covered = False
fail_under = 100
