{
  "mcpServers": {
    "python-code-guard": {
      "command": "${CLAUDE_PROJECT_DIR}/.venv/bin/python",
      "args": ["${CLAUDE_PROJECT_DIR}/mcp_guard_server.py"],
      "env": {
        "PYTHONPATH": "${CLAUDE_PROJECT_DIR}"
      }
    },
    "claude-subtask-workflow": {
      "command": "${CLAUDE_PROJECT_DIR}/.venv/bin/python",
      "args": ["${CLAUDE_PROJECT_DIR}/mcp_claude_workflow.py"],
      "env": {
        "PYTHONPATH": "${CLAUDE_PROJECT_DIR}"
      }
    }
  }
}
