# ── Dockerfile.web ──────────────────────────────────────────────────
# Multi-stage build for the SuperGravity web dashboard.
# Deploys to Cloud Run with only the web dependencies.
# ────────────────────────────────────────────────────────────────────

FROM python:3.12-slim AS builder

# Install uv for fast dependency resolution
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app

# Copy dependency files first for layer caching
COPY pyproject.toml uv.lock ./

# Install only web dependencies (no GPU, no training)
RUN uv sync --frozen --no-dev --extra web

# Copy application code
COPY anse/ anse/
COPY web/ web/
COPY results/ results/
COPY demo_self_evolution.py .
COPY demo_phase3_neuro_surgeon.py .

# ── Runtime Stage ──
FROM python:3.12-slim

WORKDIR /app

# Copy the virtual environment from builder
COPY --from=builder /app/.venv /app/.venv
COPY --from=builder /app/ /app/

# Add venv to PATH
ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1
ENV HOST=0.0.0.0
ENV PORT=8080

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8080/health')"

CMD ["python", "-m", "uvicorn", "web.server:app", "--host", "0.0.0.0", "--port", "8080"]
