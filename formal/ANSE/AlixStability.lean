/-- Power sum of the roots of `p` (with multiplicity). -/
noncomputable def psumRoots (p : ℂ[X]) (m : ℕ) : ℂ := (p.roots.map (· ^ m)).sum

/-- If no root lies outside the closed unit disc, every power sum is bounded by the number of roots. -/
theorem norm_psumRoots_le (p : ℂ[X]) (h : ∀ z, p.IsRoot z → ‖z‖ ≤ 1) (m : ℕ) :
    ‖psumRoots p m‖ ≤ Multiset.card p.roots := by
  unfold psumRoots
  calc ‖(p.roots.map (· ^ m)).sum‖ ≤ (p.roots.map (fun z => ‖z ^ m‖)).sum := by
        simpa [Multiset.map_map, Function.comp_def] using norm_multiset_sum_le (p.roots.map (· ^ m))
    _ ≤ (p.roots.map (fun _ => (1:ℝ))).sum := by
        apply Multiset.sum_map_le_sum_map
        intro z hz
        have hp : p ≠ 0 := by rintro rfl; simp at hz
        have hroot : p.IsRoot z := (mem_roots hp).1 hz
        simpa [norm_pow] using pow_le_one₀ (norm_nonneg z) (h z hroot)
    _ = Multiset.card p.roots := by simp

/-- Swap a finite sum with a multiset sum. -/
theorem finset_sum_multiset_sum {ι : Type*} (T : Finset ι) (S : Multiset ℂ) (g : ι → ℂ → ℂ) :
    ∑ j ∈ T, (S.map (g j)).sum = (S.map fun z => ∑ j ∈ T, g j z).sum := by
  induction S using Multiset.induction_on with
  | empty => simp
  | cons a s ih => simp [Multiset.map_cons, Multiset.sum_cons, Finset.sum_add_distrib, ih]

/-- The recurrence: `∑ⱼ aⱼ s_{m+j} = 0`. -/
theorem psumRoots_recurrence (p : ℂ[X]) (hp : p ≠ 0) (m : ℕ) :
    ∑ j ∈ range (p.natDegree + 1), p.coeff j * psumRoots p (m + j) = 0 := by
  unfold psumRoots
  have : ∀ z ∈ p.roots, ∑ j ∈ range (p.natDegree + 1), p.coeff j * z ^ (m + j) = 0 := by
    intro z hz
    have hroot : p.eval z = 0 := (mem_roots hp).1 hz
    rw [eval_eq_sum_range] at hroot
    calc ∑ j ∈ range (p.natDegree + 1), p.coeff j * z ^ (m + j)
        = z ^ m * ∑ j ∈ range (p.natDegree + 1), p.coeff j * z ^ j := by
          rw [Finset.mul_sum]; refine Finset.sum_congr rfl fun j _ => by ring
      _ = 0 := by rw [hroot, mul_zero]
  calc ∑ j ∈ range (p.natDegree + 1), p.coeff j * (p.roots.map (· ^ (m + j))).sum
      = ∑ j ∈ range (p.natDegree + 1), (p.roots.map (fun z => p.coeff j * z ^ (m + j))).sum := by
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [← Multiset.sum_map_mul_left]
    _ = (p.roots.map (fun z => ∑ j ∈ range (p.natDegree + 1), p.coeff j * z ^ (m + j))).sum :=
        finset_sum_multiset_sum _ _ (fun j z => p.coeff j * z ^ (m + j))
    _ = 0 := by
        apply Multiset.sum_eq_zero
        intro x hx
        obtain ⟨z, hz, rfl⟩ := Multiset.mem_map.1 hx
        exact this z hz

/-- An enumeration of a multiset by `Fin (card s)`. -/
theorem exists_enum (s : Multiset ℂ) :
    ∃ f : Fin (Multiset.card s) → ℂ, Finset.univ.val.map f = s := by
  refine ⟨fun i => s.toList.get ⟨i, by simp [Multiset.length_toList]⟩, ?_⟩
  rw [Fin.univ_val_map]
  have : List.ofFn (fun i : Fin (Multiset.card s) => s.toList.get ⟨i, by simp [Multiset.length_toList]⟩)
      = s.toList := by
    apply List.ext_getElem <;> simp [Multiset.length_toList]
  rw [this, Multiset.coe_toList]

/-- Newton's identities for the roots of a polynomial, in terms of the roots' own elementary
symmetric functions: `s_k = (-1)^(k+1) k e_k - ∑_{0<i<k} (-1)^i e_i s_{k-i}`. -/
theorem psumRoots_newton (p : ℂ[X]) (k : ℕ) (hk : 0 < k) :
    psumRoots p k = (-1) ^ (k + 1) * k * p.roots.esymm k
      - ∑ a ∈ antidiagonal k with a.1 ∈ Set.Ioo 0 k,
          (-1) ^ a.1 * p.roots.esymm a.1 * psumRoots p a.2 := by
  obtain ⟨f, hf⟩ := exists_enum p.roots
  have h := congrArg (MvPolynomial.aeval f)
    (MvPolynomial.psum_eq_mul_esymm_sub_sum (Fin (Multiset.card p.roots)) ℂ k hk)
  have hps : ∀ m, MvPolynomial.aeval f (MvPolynomial.psum (Fin (Multiset.card p.roots)) ℂ m)
      = psumRoots p m := by
    intro m
    simp only [MvPolynomial.psum, map_sum, map_pow, MvPolynomial.aeval_X, psumRoots]
    conv_rhs => rw [← hf]
    rw [Finset.sum_eq_multiset_sum, Multiset.map_map]
    rfl
  simp only [map_sub, map_mul, map_sum, map_pow, map_neg, map_one, map_natCast,
    MvPolynomial.aeval_esymm_eq_multiset_esymm, hps, hf] at h
  exact h

theorem card_roots_eq (p : ℂ[X]) : Multiset.card p.roots = p.natDegree :=
  splits_iff_card_roots.mp (IsAlgClosed.splits p)

theorem psumRoots_zero (p : ℂ[X]) : psumRoots p 0 = (p.natDegree : ℂ) := by
  unfold psumRoots
  simp [card_roots_eq]

/-- Vieta for a monic polynomial: `e_i = (-1)^i * coeff (n - i)`. -/
theorem esymm_eq_coeff (p : ℂ[X]) (hm : p.Monic) {i : ℕ} (hi : i ≤ p.natDegree) :
    p.roots.esymm i = (-1) ^ i * p.coeff (p.natDegree - i) := by
  have h := coeff_eq_esymm_roots_of_card (card_roots_eq p) (k := p.natDegree - i) (by omega)
  rw [hm.leadingCoeff, Nat.sub_sub_self hi, one_mul] at h
  rw [h, ← mul_assoc, ← pow_add, ← two_mul, pow_mul]
  simp

/-- Newton's identities for a monic polynomial, indexed by `range` so that a concrete `k`
expands by `simp [Finset.sum_range_succ]`. -/
theorem psumRoots_newton_range (p : ℂ[X]) (hm : p.Monic) (k : ℕ) (hk : 0 < k) (hkn : k ≤ p.natDegree) :
    psumRoots p k = (-1) ^ (k + 1) * k * ((-1) ^ k * p.coeff (p.natDegree - k))
      - ∑ i ∈ range (k - 1), (-1) ^ (i + 1) * ((-1) ^ (i + 1) * p.coeff (p.natDegree - (i + 1)))
          * psumRoots p (k - (i + 1)) := by
  rw [psumRoots_newton p k hk, esymm_eq_coeff p hm hkn]
  congr 1
  obtain ⟨k', rfl⟩ : ∃ k', k = k' + 1 := ⟨k - 1, by omega⟩
  rw [Finset.sum_filter, Finset.Nat.sum_antidiagonal_eq_sum_range_succ_mk]
  rw [Finset.sum_range_succ', Finset.sum_range_succ]
  have hedge1 : ¬ ((0 : ℕ) ∈ Set.Ioo 0 (k' + 1)) := by simp
  have hedge2 : ¬ ((k' + 1 : ℕ) ∈ Set.Ioo 0 (k' + 1)) := by simp
  simp only [hedge1, hedge2, ite_false, add_zero, Nat.add_sub_cancel]
  refine Finset.sum_congr rfl fun i hi => ?_
  have hi' : i < k' := Finset.mem_range.1 hi
  have hmem : (i + 1 : ℕ) ∈ Set.Ioo 0 (k' + 1) := by simp [Set.mem_Ioo]; omega
  simp only [hmem, ite_true]
  rw [esymm_eq_coeff p hm (by omega)]

