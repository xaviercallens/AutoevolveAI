fails; E ≠ 0 means the order is EXACTLY k (AlixBDF.lean proves only order ≥ k), and the
normalised error constant is E / ((k+1)! b) = −1/(k+1). -/

namespace ANSE.Alix.BDFErr

theorem bdf1_defect_nonzero : ((-1 : ℚ) * 0^2 + (1 : ℚ) * 1^2) - 2 * (1 : ℚ) * 1^1 ≠ 0 := by norm_num

theorem bdf1_error_constant :
    ((((-1 : ℚ) * 0^2 + (1 : ℚ) * 1^2) - 2 * (1 : ℚ) * 1^1) / (2 * (1 : ℚ))) = -1 / 2 := by norm_num

