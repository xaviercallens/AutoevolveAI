/-- Parallelogram law in real inner product spaces [faithful]. Proof: deepseek prover, round 0. -/
theorem mm02_parallelogram {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℝ E]
    (x y : E) : ‖x + y‖ ^ 2 + ‖x - y‖ ^ 2 = 2 * (‖x‖ ^ 2 + ‖y‖ ^ 2) := by
