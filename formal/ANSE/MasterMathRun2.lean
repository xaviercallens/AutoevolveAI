/-- Cantor's theorem (no surjection onto the power set) [faithful]. Proof: goedel prover, round 0. -/
theorem mm15_cantor {α : Type*} (f : α → Set α) : ¬ Function.Surjective f := by
    have h_main : ¬ Function.Surjective f := by
      intro h_surj
      -- Define the set S = {x : α | x ∉ f x}
      let S : Set α := {x : α | x ∉ f x}
      -- Assume for contradiction that S is in the image of f
      have h₁ : ∃ (y : α), f y = S := by
        -- Since f is surjective, there exists y such that f y = S
        have h₂ : S ∈ Set.range f := by
          apply h_surj
        -- Obtain y such that f y = S
        rcases h₂ with ⟨y, hy⟩
        exact ⟨y, by simpa using hy⟩
      -- Obtain y such that f y = S
      rcases h₁ with ⟨y, hy⟩
      -- Consider whether y ∈ S or y ∉ S
      by_cases h : y ∈ S
      · -- Case: y ∈ S
        have h₂ : y ∉ f y := h
        have h₃ : f y = S := hy
        have h₄ : y ∉ S := by simpa [h₃] using h₂
        contradiction
      · -- Case: y ∉ S
        have h₂ : y ∈ f y := by
          have h₃ : y ∉ S := h
          have h₄ : y ∉ f y → False := by
            intro h₅
            have h₆ : y ∈ S := by
              have h₇ : y ∉ f y := h₅
              have h₈ : y ∈ S := by
                simpa [S, Set.mem_setOf_eq] using h₇
              exact h₈
            contradiction
          by_contra h₅
          exact h₄ h₅
        have h₃ : f y = S := hy
        have h₄ : y ∈ S := by simpa [h₃] using h₂
        contradiction
    exact h_main

