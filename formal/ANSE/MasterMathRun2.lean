/-- Discrete Gronwall inequality [faithful]. Proof: deepseek prover, round 0. -/
theorem mm07_gronwall (E : ℕ → ℝ) (α : ℝ) (hα : 0 ≤ α) (hE : ∀ n, 0 ≤ E n)
    (h_step : ∀ n, E (n + 1) ≤ (1 + α) * E n) : ∀ n, E n ≤ (1 + α) ^ n * E 0 := by
    intro n
    induction n with
    | zero =>
      simp
    | succ n ih =>
      calc
        E (n + 1) ≤ (1 + α) * E n := h_step n
        _ ≤ (1 + α) * ((1 + α) ^ n * E 0) := by
          gcongr
          <;> simp_all [pow_succ]
          <;> nlinarith
        _ = (1 + α) ^ (n + 1) * E 0 := by
          simp [pow_succ, mul_assoc]
          <;> ring

/-- The false variant used as a negative control is refuted. -/
theorem mm07_gronwall_F_refuted : ¬ (∀ E : ℕ → ℝ, (∀ n, 0 ≤ E n) → (∀ n, E (n + 1) ≤ 2 * E n) → ∀ n, E n ≤ E 0) := by
    intro h
    have := h (fun n => 2 ^ n) (fun n => by positivity)
      (fun n => le_of_eq (by ring)) 1
    norm_num at this

