    obtain ⟨x, -, hu⟩ := h id LipschitzWith.id
    have h1 := hu (x + 1) rfl
    linarith

/-- Cauchy-Riemann implies harmonic (second-derivative algebra only) [proxy]. Proof: deepseek prover, round 0. Derivatives are free real variables; no function or differentiability appears. -/
theorem mm04_cr_harmonic (u_xx u_yy v_xy v_yx : ℝ) (hCR1 : u_xx = v_yx)
    (hCR2 : u_yy = -v_xy) (hSym : v_yx = v_xy) : u_xx + u_yy = 0 := by
    have h1 : u_xx = v_yx := hCR1
    have h2 : u_yy = -v_xy := hCR2
    have h3 : v_yx = v_xy := hSym
