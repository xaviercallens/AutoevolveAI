/-- Banach contraction principle (unique fixed point) [faithful]. Proof: reference control proof (no prover proof passed the kernel). -/
theorem mm03_banach {X : Type*} [MetricSpace X] [CompleteSpace X] [Nonempty X]
    {c : NNReal} (hc : c < 1) {T : X → X} (hT : LipschitzWith c T) :
    ∃! x : X, T x = x := by
    have hK : ContractingWith c T := ⟨hc, hT⟩
    exact ⟨ContractingWith.fixedPoint T hK, hK.fixedPoint_isFixedPt,
      fun y hy => hK.fixedPoint_unique hy⟩

