import Mathlib.Tactic

set_option linter.unusedSimpArgs false
set_option maxHeartbeats 0
namespace SLRAudit.N08

/-- velocities of certificate n = 8 -/
def v : Fin 8 → ℕ := ![1, 2, 3, 4, 5, 6, 7, 8]
/-- shifts s_i = a_i / 1296 -/
def s : Fin 8 → ℚ := ![137/1296, 1029/1296, 1140/1296, 1176/1296, 1089/1296, 113/1296, 905/1296, 556/1296]

theorem v_injective : Function.Injective v := by decide
theorem v_pos : ∀ i, 0 < v i := by decide

/-- covering: for every real t some runner is within distance < 1/9 of an integer. -/
theorem cover : ∀ t : ℝ, ∃ i : Fin 8, ∃ k : ℤ, |((s i : ℚ) : ℝ) + ((v i : ℕ) : ℝ) * t - (k : ℝ)| < 1 / 9 := by
