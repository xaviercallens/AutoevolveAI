import Mathlib.Tactic

set_option linter.unusedSimpArgs false
set_option maxHeartbeats 0
namespace SLRAudit.N09

/-- velocities of certificate n = 9 -/
def v : Fin 9 → ℕ := ![1, 2, 3, 4, 5, 6, 7, 8, 9]
/-- shifts s_i = a_i / 1600 -/
def s : Fin 9 → ℚ := ![569/1600, 513/1600, 1106/1600, 1467/1600, 181/1600, 995/1600, 920/1600, 700/1600, 1087/1600]

theorem v_injective : Function.Injective v := by decide
theorem v_pos : ∀ i, 0 < v i := by decide

/-- covering: for every real t some runner is within distance < 1/10 of an integer. -/
theorem cover : ∀ t : ℝ, ∃ i : Fin 9, ∃ k : ℤ, |((s i : ℚ) : ℝ) + ((v i : ℕ) : ℝ) * t - (k : ℝ)| < 1 / 10 := by
