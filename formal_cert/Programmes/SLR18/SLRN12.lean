/-- shifts s_i = a_i / 2704 -/
def s : Fin 12 → ℚ := ![253/2704, 1952/2704, 2501/2704, 2331/2704, 1918/2704, 1477/2704, 1463/2704, 1341/2704, 215/2704, 2090/2704, 1939/2704, 2335/2704]

theorem v_injective : Function.Injective v := by decide
theorem v_pos : ∀ i, 0 < v i := by decide

