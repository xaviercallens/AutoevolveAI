/-- shifts s_i = a_i / 11664 -/
def s : Fin 26 → ℚ := ![5848/11664, 4310/11664, 9110/11664, 3298/11664, 601/11664, 3872/11664, 11313/11664, 2542/11664, 9276/11664, 5264/11664, 492/11664, 6275/11664, 8890/11664, 2714/11664, 6541/11664, 9281/11664, 11449/11664, 1767/11664, 4200/11664, 7718/11664, 1130/11664, 10287/11664, 5675/11664, 11135/11664, 8832/11664, 2817/11664]

theorem v_injective : Function.Injective v := by decide
theorem v_pos : ∀ i, 0 < v i := by decide

