namespace YukawaBccFcc

open Finset

def Ntab : ℕ → ℕ
  | 1 => 12
  | 2 => 6
  | 3 => 24
  | 4 => 12
  | 5 => 24
  | 6 => 8
  | 7 => 48
  | 8 => 6
  | 9 => 36
  | 10 => 24
  | 11 => 24
  | 12 => 24
