theorem segment_pos0 (F : ℝ → ℝ → ℝ) (h : Encloses F t0 Lpos) :
    ∀ a : ℝ, ((((198 : ℚ) / 125) : ℚ) : ℝ) ≤ a → a ≤ (((4 : ℚ) : ℚ) : ℝ) → ∀ t : ℝ, |t| ≤ t0 → 0 < F a t := by
