noncomputable def epsFree (hc ks k : (*@$\mathbb{R}$@*)) : (*@$\mathbb{R}$@*) := hc * k ^ 2 / ks

noncomputable def epsBog (hc ks k : (*@$\mathbb{R}$@*)) : (*@$\mathbb{R}$@*) := Real.sqrt (bogoliubovSq hc ks k)

noncomputable def sBog (hc ks k : (*@$\mathbb{R}$@*)) : (*@$\mathbb{R}$@*) := epsFree hc ks k / epsBog hc ks k
