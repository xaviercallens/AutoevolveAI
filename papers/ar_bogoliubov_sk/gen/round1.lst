theorem bogoliubovSq_pos {hc ks k : (*@$\mathbb{R}$@*)} (hhc : 0 < hc) (hk : 0 < k) :
    0 < bogoliubovSq hc ks k := -- proof elided

theorem epsBog_sq {hc ks k : (*@$\mathbb{R}$@*)} (hhc : 0 < hc) (hk : 0 < k) :
    epsBog hc ks k ^ 2 = epsFree hc ks k ^ 2 + (hc * k) ^ 2 := -- proof elided

theorem sBog_pos {hc ks k : (*@$\mathbb{R}$@*)} (hhc : 0 < hc) (hk : 0 < k) (hks : 0 < ks) :
    0 < sBog hc ks k := -- proof elided

theorem sBog_sq {hc ks k : (*@$\mathbb{R}$@*)} (hhc : 0 < hc) (hk : 0 < k) (hks : 0 < ks) :
    sBog hc ks k ^ 2 = k ^ 2 / (ks ^ 2 + k ^ 2) := -- proof elided

theorem sBog_sq_le {hc ks k : (*@$\mathbb{R}$@*)} (hhc : 0 < hc) (hk : 0 < k) (hks : 0 < ks) :
    sBog hc ks k ^ 2 (*@$\le$@*) k / (2 * ks) := -- proof elided

theorem sBog_le_sqrt {hc ks k : (*@$\mathbb{R}$@*)} (hhc : 0 < hc) (hk : 0 < k) (hks : 0 < ks) :
    sBog hc ks k (*@$\le$@*) Real.sqrt (k / (2 * ks)) := -- proof elided

theorem sBog_sq_eq_iff {hc ks k : (*@$\mathbb{R}$@*)} (hhc : 0 < hc) (hk : 0 < k) (hks : 0 < ks) :
    sBog hc ks k ^ 2 = k / (2 * ks) (*@$\leftrightarrow$@*) k = ks := -- proof elided

theorem feynman_sBog_exact {hc ks k : (*@$\mathbb{R}$@*)} (hhc : 0 < hc) (hk : 0 < k) (hks : 0 < ks) :
    (hc * k ^ 2 / (ks * sBog hc ks k)) ^ 2 = bogoliubovSq hc ks k := -- proof elided

theorem sBog_sq_le_via_project {hc ks k : (*@$\mathbb{R}$@*)} (hhc : 0 < hc) (hk : 0 < k) (hks : 0 < ks) :
    sBog hc ks k ^ 2 (*@$\le$@*) k / (2 * ks) := -- proof elided

theorem free_S_one_violates {ks k : (*@$\mathbb{R}$@*)} (_hk : 0 < k) (hks : 0 < ks) (hlt : k < 2 * ks) :
    Real.sqrt (k / (2 * ks)) < 1 := -- proof elided
