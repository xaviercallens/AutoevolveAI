theorem diffraction_test_model {hc ks k S : (*@$\mathbb{R}$@*)} (hhc : 0 < hc) (hk : 0 < k) (hks : 0 < ks)
    (hpeak : Real.sqrt (k / (2 * ks)) < S) : S (*@$\ne$@*) sBog hc ks k := -- proof elided

theorem diffraction_test_dispersion {hc ks k S epsSq : (*@$\mathbb{R}$@*)} (hhc : 0 < hc) (hk : 0 < k)
    (hks : 0 < ks) (hS : 0 < S)
    (hfeyn : epsSq (*@$\le$@*) (hc * k ^ 2 / (ks * S)) ^ 2)
    (hpeak : Real.sqrt (k / (2 * ks)) < S) : epsSq (*@$\ne$@*) bogoliubovSq hc ks k := -- proof elided

theorem peak_sqrt_iff_sq {ks k S : (*@$\mathbb{R}$@*)} (hS : 0 < S) :
    Real.sqrt (k / (2 * ks)) < S (*@$\leftrightarrow$@*) k / (2 * ks) < S ^ 2 := -- proof elided

theorem diffraction_fires_free_at_selfdual {hc ks : (*@$\mathbb{R}$@*)} (hhc : 0 < hc) (hks : 0 < ks) :
    (1 : (*@$\mathbb{R}$@*)) (*@$\ne$@*) sBog hc ks ks := -- proof elided

theorem diffraction_silent_on_sBog {hc ks k : (*@$\mathbb{R}$@*)} (hhc : 0 < hc) (hk : 0 < k) (hks : 0 < ks) :
    (*@$\neg$@*) (Real.sqrt (k / (2 * ks)) < sBog hc ks k) := -- proof elided

theorem free_S_one_violates_phonon {ks k : (*@$\mathbb{R}$@*)} (hks : 0 < ks) (hlt : k < ks) : k / ks < 1 := -- proof elided

theorem nonvacuous_selfdual : sBog 1 1 1 ^ 2 = 1 / (2 * 1) := -- proof elided
