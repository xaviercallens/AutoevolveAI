noncomputable def g (d : (*@$\mathbb{R}$@*)) : (*@$\mathbb{R}$@*) (*@$\to$@*) (*@$\mathbb{R}$@*) := fun t => 2 * (t ^ (-(1 / 2 : (*@$\mathbb{R}$@*))) - (t + d ^ 2) ^ (-(1 / 2 : (*@$\mathbb{R}$@*))))

noncomputable def h (d : (*@$\mathbb{R}$@*)) : (*@$\mathbb{R}$@*) (*@$\to$@*) (*@$\mathbb{R}$@*) := fun t => t ^ (-(1 / 2 : (*@$\mathbb{R}$@*))) - 2 * (t + d ^ 2) ^ (-(1 / 2 : (*@$\mathbb{R}$@*)))

noncomputable def shiftDiff (s c : (*@$\mathbb{R}$@*)) : (*@$\mathbb{R}$@*) (*@$\to$@*) (*@$\mathbb{R}$@*) := fun t => t ^ (-(s / 2)) - (t + c) ^ (-(s / 2))
