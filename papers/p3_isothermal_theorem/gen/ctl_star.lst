theorem star_bias :
    upP (fun _ => 1) Wstar 2 {0} = 1 / 2 (*@$\wedge$@*) downP (fun _ => 1) Wstar 2 {0} = 1 / 2 (*@$\wedge$@*)
    upP (fun _ => 1) Wstar 2 {0} (*@$\ne$@*) 2 * downP (fun _ => 1) Wstar 2 {0} := -- proof elided

theorem star_fixation_centre :
    Tendsto (fun t => sPow (bdK (fun _ => 1) Wstar 2) t {0} univ) atTop ((*@$\mathcal{N}$@*) (5 / 12)) := -- proof elided

theorem star_fixation_leaf :
    Tendsto (fun t => sPow (bdK (fun _ => 1) Wstar 2) t {1} univ) atTop ((*@$\mathcal{N}$@*) (2 / 3)) := -- proof elided

theorem star_fixation_uniform :
    Tendsto (fun t => ((*@$\sum$@*) v : Fin 3, sPow (bdK (fun _ => 1) Wstar 2) t {v} univ) / 3) atTop
      ((*@$\mathcal{N}$@*) (7 / 12)) := -- proof elided

theorem star_ne_moran : (5 / 12 : (*@$\mathbb{R}$@*)) (*@$\ne$@*) moranFix 3 2 1 (*@$\wedge$@*) (7 / 12 : (*@$\mathbb{R}$@*)) (*@$\ne$@*) moranFix 3 2 1 (*@$\wedge$@*)
    (2 / 3 : (*@$\mathbb{R}$@*)) (*@$\ne$@*) moranFix 3 2 1 := -- proof elided
