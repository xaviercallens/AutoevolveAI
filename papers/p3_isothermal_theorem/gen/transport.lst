noncomputable def sPow (P : (*@$\sigma$@*) (*@$\to$@*) (*@$\sigma$@*) (*@$\to$@*) (*@$\mathbb{R}$@*)) : (*@$\mathbb{N}$@*) (*@$\to$@*) (*@$\sigma$@*) (*@$\to$@*) (*@$\sigma$@*) (*@$\to$@*) (*@$\mathbb{R}$@*)
  | 0 => fun s u => if s = u then 1 else 0
  | t + 1 => fun s u => (*@$\sum$@*) v, sPow P t s v * P v u

structure TwoAbsorbing (P : (*@$\sigma$@*) (*@$\to$@*) (*@$\sigma$@*) (*@$\to$@*) (*@$\mathbb{R}$@*)) (bot top : (*@$\sigma$@*)) : Prop where
  ne : bot (*@$\ne$@*) top
  nonneg : (*@$\forall$@*) s u, 0 (*@$\le$@*) P s u
  rowSum : (*@$\forall$@*) s, (*@$\sum$@*) u, P s u = 1
  absorbBot : (*@$\forall$@*) u, P bot u = if u = bot then 1 else 0
  absorbTop : (*@$\forall$@*) u, P top u = if u = top then 1 else 0

theorem two_absorbing_limit {P : (*@$\sigma$@*) (*@$\to$@*) (*@$\sigma$@*) (*@$\to$@*) (*@$\mathbb{R}$@*)} {bot top : (*@$\sigma$@*)} (hP : TwoAbsorbing P bot top)
    {h : (*@$\sigma$@*) (*@$\to$@*) (*@$\mathbb{R}$@*)} (hh : (*@$\forall$@*) s, s (*@$\ne$@*) bot (*@$\to$@*) s (*@$\ne$@*) top (*@$\to$@*) (*@$\sum$@*) u, P s u * h u = h s) (h0 : h bot = 0)
    (h1 : h top = 1) (hvar : (*@$\forall$@*) s, s (*@$\ne$@*) bot (*@$\to$@*) s (*@$\ne$@*) top (*@$\to$@*) 0 < (*@$\sum$@*) u, P s u * (h u - h s) ^ 2)
    (s : (*@$\sigma$@*)) :
    Tendsto (fun t => sPow P t s top) atTop ((*@$\mathcal{N}$@*) (h s)) (*@$\wedge$@*)
    Tendsto (fun t => sPow P t s bot) atTop ((*@$\mathcal{N}$@*) (1 - h s)) := -- proof elided
