theorem ctl_sorry {E : Type*} [NormedAddCommGroup E] [InnerProductSpace (*@$\mathbb{C}$@*) E]
    [FiniteDimensional (*@$\mathbb{C}$@*) E] (H (*@$\rho$@*) : E (*@$\to$@*)(*@$_\ell$@*)[(*@$\mathbb{C}$@*)] E) (E0 : (*@$\mathbb{R}$@*)) ((*@$\psi$@*) : E) (_hH : H.IsSymmetric)
    (_h(*@$\psi$@*) : H (*@$\psi$@*) = (E0 : (*@$\mathbb{C}$@*)) (*@$\bullet$@*) (*@$\psi$@*)) :
    excess H E0 (*@$\psi$@*) (*@$\rho$@*) = (*@$\langle$@*)(*@$\psi$@*), comm (adjoint (*@$\rho$@*)) (comm H (*@$\rho$@*)) (*@$\psi$@*)(*@$\rangle$@*)_(*@$\mathbb{C}$@*) := sorry

axiom ctl_cheat : False

theorem ctl_axiom {E : Type*} [NormedAddCommGroup E] [InnerProductSpace (*@$\mathbb{C}$@*) E]
    [FiniteDimensional (*@$\mathbb{C}$@*) E] (H (*@$\rho$@*) : E (*@$\to$@*)(*@$_\ell$@*)[(*@$\mathbb{C}$@*)] E) (E0 : (*@$\mathbb{R}$@*)) ((*@$\psi$@*) : E) (_hH : H.IsSymmetric)
    (_h(*@$\psi$@*) : H (*@$\psi$@*) = (E0 : (*@$\mathbb{C}$@*)) (*@$\bullet$@*) (*@$\psi$@*)) :
    excess H E0 (*@$\psi$@*) (*@$\rho$@*) = (*@$\langle$@*)(*@$\psi$@*), comm (adjoint (*@$\rho$@*)) (comm H (*@$\rho$@*)) (*@$\psi$@*)(*@$\rangle$@*)_(*@$\mathbb{C}$@*) := ctl_cheat.elim
