def comm (A B : E (*@$\to$@*)(*@$_\ell$@*)[(*@$\mathbb{C}$@*)] E) : E (*@$\to$@*)(*@$_\ell$@*)[(*@$\mathbb{C}$@*)] E := A (*@$\circ$@*)(*@$_\ell$@*) B - B (*@$\circ$@*)(*@$_\ell$@*) A

noncomputable def excess (H : E (*@$\to$@*)(*@$_\ell$@*)[(*@$\mathbb{C}$@*)] E) (E0 : (*@$\mathbb{R}$@*)) ((*@$\psi$@*) : E) (X : E (*@$\to$@*)(*@$_\ell$@*)[(*@$\mathbb{C}$@*)] E) : (*@$\mathbb{C}$@*) :=
  (*@$\langle$@*)X (*@$\psi$@*), H (X (*@$\psi$@*))(*@$\rangle$@*)_(*@$\mathbb{C}$@*) - (E0 : (*@$\mathbb{C}$@*)) * (*@$\langle$@*)X (*@$\psi$@*), X (*@$\psi$@*)(*@$\rangle$@*)_(*@$\mathbb{C}$@*)
