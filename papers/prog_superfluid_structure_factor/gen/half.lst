theorem excess_eq_half (hH : H.IsSymmetric) (h(*@$\psi$@*) : H (*@$\psi$@*) = (E0 : (*@$\mathbb{C}$@*)) (*@$\bullet$@*) (*@$\psi$@*)) ((*@$\rho$@*) : E (*@$\to$@*)(*@$_\ell$@*)[(*@$\mathbb{C}$@*)] E) {f : (*@$\mathbb{C}$@*)}
    (hf : (*@$\langle$@*)(*@$\psi$@*), comm (adjoint (*@$\rho$@*)) (comm H (*@$\rho$@*)) (*@$\psi$@*)(*@$\rangle$@*)_(*@$\mathbb{C}$@*) = f)
    (hsym : excess H E0 (*@$\psi$@*) (adjoint (*@$\rho$@*)) = excess H E0 (*@$\psi$@*) (*@$\rho$@*)) :
    excess H E0 (*@$\psi$@*) (*@$\rho$@*) = f / 2 := by
  rw [double_comm_expect hH h(*@$\psi$@*), hsym] at hf
  rw [(*@$\leftarrow$@*) hf]; ring
