class JEPAWorldModel(nn.Module):
    """
    Predicts the NEXT latent state given the current state and a proposed action.
    It operates entirely in conceptual latent space, avoiding token-level noise.
    """
    def __init__(self, latent_dim=256):
        super().__init__()
        self.predictor = nn.Sequential(
            nn.Linear(latent_dim * 2, 512),
            nn.LayerNorm(512),
            nn.GELU(),
            nn.Linear(512, latent_dim)
        )
        
    def forward(self, current_state, proposed_action):
        combined = torch.cat([current_state, proposed_action], dim=-1)
        expected_future = self.predictor(combined)
        return expected_future

